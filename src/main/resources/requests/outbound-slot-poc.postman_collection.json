{
  "info": {
    "name": "outbound-slot-poc (A20-3142)",
    "description": "Every endpoint of the lane / connector / service slot POC. Run the onboard requests first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8085/api/v1" }
  ],
  "item": [
    {
      "name": "1. Onboard S3_connector_1 (130 slots; bucket1 18, bucket2 30)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/connectors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"connectorId\": \"S3_connector_1\",\n  \"slots\": 130,\n  \"lanes\": [\n    { \"laneId\": \"stage-1:bucket1\", \"slots\": 18, \"latencyMs\": 600 },\n    { \"laneId\": \"stage-2:bucket2\", \"slots\": 30, \"latencyMs\": 300 }\n  ]\n}"
        }
      }
    },
    {
      "name": "2. Onboard S3_connector_2 (100 slots; bucket3 30)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/connectors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"connectorId\": \"S3_connector_2\",\n  \"slots\": 100,\n  \"lanes\": [\n    { \"laneId\": \"stage-3:bucket3\", \"slots\": 30, \"latencyMs\": 300 }\n  ]\n}"
        }
      }
    },
    {
      "name": "3. Onboard Kafka_connector_1 (over-subscribed, default latency)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/connectors",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"connectorId\": \"Kafka_connector_1\",\n  \"slots\": 20,\n  \"lanes\": [\n    { \"laneId\": \"stage-4:topic1\", \"slots\": 15 },\n    { \"laneId\": \"stage-5:topic2\", \"slots\": 15 }\n  ]\n}"
        }
      }
    },
    {
      "name": "4. Get connector S3_connector_1",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/connectors/S3_connector_1"
      }
    },
    {
      "name": "5. Submit request (202 or 429)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/requests",
        "body": { "mode": "raw", "raw": "{\n  \"laneId\": \"stage-1:bucket1\"\n}" }
      }
    },
    {
      "name": "6. Submit request with latency override (holds the slot 5 s)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/requests",
        "body": { "mode": "raw", "raw": "{\n  \"laneId\": \"stage-1:bucket1\",\n  \"latencyMs\": 5000\n}" }
      }
    },
    {
      "name": "7. Get stats",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/stats"
      }
    },
    {
      "name": "8. Error: unknown lane (404)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/requests",
        "body": { "mode": "raw", "raw": "{\n  \"laneId\": \"no-such-lane\"\n}" }
      }
    }
  ]
}
